generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum para el estado de la solicitud
enum RequestStatusEnum {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

// Enum para el estado del documento
enum DocumentStatusEnum {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
  EXPIRED
}

// Enum para el estado del contrato
enum ContractStatusEnum {
  DRAFT
  GENERATED
  SIGNED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

model Role {
  id   Int    @id @default(autoincrement())
  name String

  users User[]
}

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String  @unique
  password String?
  role_id  Int

  role            Role           @relation(fields: [role_id], references: [id])
  histories       History[]
  notifications   Notification[]
  createdRequests Request[]      @relation("RequestCreator")
}

model Faculty {
  id   Int    @id @default(autoincrement())
  name String

  departments Department[]
}

model Department {
  id         Int    @id @default(autoincrement())
  name       String
  faculty_id Int

  faculty  Faculty   @relation(fields: [faculty_id], references: [id])
  requests Request[]
}

model WorkCenter {
  id       Int     @id @default(autoincrement())
  name     String
  organism String?
  position String?

  professors Professor[]
}

model Professor {
  id                   Int     @id @default(autoincrement())
  name                 String
  ci                   String?
  address              String?
  phone                String?
  is_retired           Boolean
  work_center_id       Int
  scientific_degree_id Int?
  teaching_category_id Int

  work_center       WorkCenter        @relation(fields: [work_center_id], references: [id])
  scientific_degree ScientificDegree? @relation(fields: [scientific_degree_id], references: [id])
  teaching_category TeachingCategory  @relation(fields: [teaching_category_id], references: [id])
  requests          Request[]
}

model ScientificDegree {
  id         Int         @id @default(autoincrement())
  name       String
  professors Professor[]
}

model TeachingCategory {
  id         Int         @id @default(autoincrement())
  name       String
  professors Professor[]
}

// NOTA: Esta tabla se puede eliminar ahora porque usamos RequestStatusEnum directamente
// Se mantiene por compatibilidad, pero puedes optar por no usarla
model RequestStatus {
  id   Int    @id @default(autoincrement())
  name String

  requests Request[]
}

model Request {
  id            Int               @id @default(autoincrement())
  professor_id  Int
  department_id Int
  created_by    Int
  status        RequestStatusEnum @default(PENDING)
  date          DateTime

  professor  Professor  @relation(fields: [professor_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])
  creator    User       @relation("RequestCreator", fields: [created_by], references: [id])

  documents       Document[]
  histories       History[]
  contract        Contract?
  requestStatus   RequestStatus? @relation(fields: [requestStatusId], references: [id])
  requestStatusId Int?
}

model Document {
  id         Int                @id @default(autoincrement())
  request_id Int
  type       String
  file_path  String?
  status     DocumentStatusEnum @default(PENDING)

  request Request @relation(fields: [request_id], references: [id])
}

model History {
  id         Int      @id @default(autoincrement())
  request_id Int
  user_id    Int
  action     String
  date       DateTime

  request Request @relation(fields: [request_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])
}

model Contract {
  id              Int                @id @default(autoincrement())
  request_id      Int                @unique
  generation_date DateTime
  document_path   String?
  status          ContractStatusEnum @default(DRAFT)

  request Request @relation(fields: [request_id], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  user_id   Int
  message   String
  read      Boolean  @default(false)
  sent_date DateTime

  user User @relation(fields: [user_id], references: [id])
}
